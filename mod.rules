ID = "morgott.miningdrone"
Name = "Autofleet"
Version = "0.1.3"
Author = "Morgott"
CompatibleGameVersions = ["0.30.5"]
Description = "Automates your own ships with composable behaviour profiles: mine asteroids (circle zone, nearest or around an anchor ship), loot wrecks and loose resources, offload to a chosen ship when the hold is full, avoid or flee enemies, follow an anchor. State icons above ships. Window: menu-bar button or Ctrl+Alt+A. Requires Yet Another Mod Loader."
Dependencies = ["3577650065"]
ModifiesMultiplayer = true
StringsFolder = "strings"
