<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Game runs on net10.0 (Bin\Cosmoteer.runtimeconfig.json), so the mod targets net10.0 too.
    lib\ holds publicized (stripped) copies of Cosmoteer.dll / HalflingCore.dll (target PublicizeGameAssemblies;
    needs the global tool: dotnet tool install -g BepInEx.AssemblyPublicizer.Cli).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Autofleet</AssemblyName>
    <RootNamespace>MiningDrone</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameBin>D:\Steam\steamapps\common\Cosmoteer\Bin</GameBin>
    <!-- tools\ (jitcheck) and tests\ are separate projects; never compile them into the mod. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Regenerate lib\ (gitignored) from the installed game when missing or older than the game DLL. -->
  <Target Name="PublicizeGameAssemblies" BeforeTargets="ResolveAssemblyReferences"
          Inputs="$(GameBin)\Cosmoteer.dll;$(GameBin)\HalflingCore.dll"
          Outputs="lib\Cosmoteer.dll;lib\HalflingCore.dll">
    <Exec Command="assembly-publicizer &quot;$(GameBin)\Cosmoteer.dll&quot; &quot;$(GameBin)\HalflingCore.dll&quot; --strip -f -o &quot;$(MSBuildProjectDirectory)\lib&quot;"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <ItemGroup>
    <Reference Include="Cosmoteer">
      <HintPath>lib\Cosmoteer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HalflingCore">
      <HintPath>lib\HalflingCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    No Harmony: the mod only uses public game events (Director.FrameEnded, SimOverlayRenderer.DrawingCustomOverlays).
    Do NOT ship a 0Harmony.dll: YAML ModLoader accepts only the build with MVID dc2e7251-4b84-4883-90eb-eb05a041522c,
    which the loader mod (workshop 3577650065, our dependency) already ships; a NuGet build is rejected as "incorrect GUID".
  -->

  <ItemGroup>
    <None Include="mod.rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="strings\*.rules" CopyToOutputDirectory="PreserveNewest" LinkBase="strings" />
  </ItemGroup>
</Project>
